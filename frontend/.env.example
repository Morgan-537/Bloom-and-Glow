# Copy this file to .env (same folder) and fill in real values.
# .env is gitignored — never commit real keys.

# Unsplash "Demo" API key — used by Admin > Products to search for product
# photos instead of pasting image URLs by hand. Free, no credit card:
#   1. Sign up at https://unsplash.com/developers
#   2. Create an app (choose the free "Demo" tier)
#   3. Copy its "Access Key" below
VITE_UNSPLASH_ACCESS_KEY=
