# Copy this file to .env (same folder) and fill in real values.
# .env is gitignored — never commit real secrets.

# Postgres connection string.
# Local dev example: postgresql://bloomglow:bloomglow_dev@localhost:5432/bloom_and_glow
# Render/production: Render gives you this string directly on the Postgres
# instance's "Info" page (use the "External Database URL" if connecting from
# outside Render, "Internal Database URL" if the Flask service is also on Render).
DATABASE_URL=postgresql://bloomglow:bloomglow_dev@localhost:5432/bloom_and_glow

# Used to sign JWTs. Generate a real random value for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated list of frontend origins allowed to call this API.
# Include your local dev server and your deployed Vercel URL(s).
CORS_ORIGINS=http://localhost:5173,https://bloom-and-glow-ten.vercel.app
